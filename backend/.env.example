APP_ENV=dev
APP_PORT=8000
APP_HOST=127.0.0.1
# Comma-separated browser origins. Wildcards are ignored when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

DATA_DIR=./data

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_CHAT_PATH=/chat/completions
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX=Bearer 

LLM_TIMEOUT_SEC=60
GLM_TIMEOUT_SEC=180

# Multimodal image/PPT and quiz generation use Zhipu GLM exclusively.
GLM_TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TEXT_API_KEY=
GLM_TEXT_MODEL=glm-4-flash
GLM_TEXT_ENDPOINT=/chat/completions
GLM_IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_IMAGE_API_KEY=
GLM_IMAGE_MODEL=glm-image
GLM_IMAGE_ENDPOINT=/images/generations
GLM_IMAGE_SIZE=1344x768

LLM_PROFILE_BASE_URL=https://api.deepseek.com
LLM_PROFILE_API_KEY=
LLM_PROFILE_MODEL=deepseek-v4-flash
LLM_PROFILE_CHAT_PATH=/chat/completions
LLM_PROFILE_AUTH_HEADER=
LLM_PROFILE_AUTH_PREFIX=

LLM_CLARIFY_BASE_URL=
LLM_CLARIFY_API_KEY=
LLM_CLARIFY_MODEL=
LLM_CLARIFY_CHAT_PATH=
LLM_CLARIFY_AUTH_HEADER=
LLM_CLARIFY_AUTH_PREFIX=

LLM_GENERATE_BASE_URL=
LLM_GENERATE_API_KEY=
LLM_GENERATE_MODEL=
LLM_GENERATE_CHAT_PATH=
LLM_GENERATE_AUTH_HEADER=
LLM_GENERATE_AUTH_PREFIX=

LLM_PLAN_BASE_URL=https://api.deepseek.com
LLM_PLAN_API_KEY=
LLM_PLAN_MODEL=deepseek-v4-flash
LLM_PLAN_CHAT_PATH=/chat/completions
LLM_PLAN_AUTH_HEADER=
LLM_PLAN_AUTH_PREFIX=

LLM_TUTOR_BASE_URL=https://api.deepseek.com
LLM_TUTOR_API_KEY=
LLM_TUTOR_MODEL=deepseek-v4-flash
LLM_TUTOR_CHAT_PATH=/chat/completions
LLM_TUTOR_AUTH_HEADER=
LLM_TUTOR_AUTH_PREFIX=

LLM_EVALUATE_BASE_URL=https://api.deepseek.com
LLM_EVALUATE_API_KEY=
LLM_EVALUATE_MODEL=deepseek-v4-flash
LLM_EVALUATE_CHAT_PATH=/chat/completions
LLM_EVALUATE_AUTH_HEADER=
LLM_EVALUATE_AUTH_PREFIX=

# Xingyuan digital human configuration. Do not commit real keys.
XINGYUAN_APP_ID=
XINGYUAN_APP_SECRET=
XINGYUAN_AVATAR_BASE_URL=https://nebula-agent.xingyun3d.com
XINGYUAN_AVATAR_SESSION_PATH=/user/v1/ttsa/session
XINGYUAN_AVATAR_SPEAK_PATH=
XINGYUAN_AVATAR_STOP_PATH=
XINGYUAN_AVATAR_INTERRUPT_PATH=
XINGYUAN_AVATAR_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
XINGYUAN_AVATAR_GRANT_TTL_SECONDS=120
XINGYUAN_AVATAR_SIGNATURE_SKEW_SECONDS=60
XINGYUAN_AVATAR_ACTIVE_SESSION_TTL_SECONDS=3600
XINGYUAN_AVATAR_MAX_SESSION_STARTS_PER_GRANT=3
XINGYUAN_AVATAR_MAX_ACTIVE_GRANTS=256

# Realtime voice gateway. If empty, /api/voice/realtime/config returns disabled.
VOICE_REALTIME_BASE_URL=
VOICE_REALTIME_API_KEY=
VOICE_REALTIME_MODEL=
VOICE_REALTIME_WS_PATH=
